<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latestmajor</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <RootNamespace>KUKULCAN.SharedKernel.i18n.API</RootNamespace>
        <AssemblyName>KUKULCAN.SharedKernel.i18n</AssemblyName>
        <SolutionDir>$(MSBuildThisFileDirectory)</SolutionDir>
        <BaseOutputPath>$(SolutionDir)Bin\$(MSBuildProjectName)\</BaseOutputPath>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="KUKULCAN.SharedKernel.i18n.API.Integration" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\KUKULCAN.SharedKernel.i18n.Application\KUKULCAN.SharedKernel.i18n.Application.csproj" />
        <ProjectReference Include="..\KUKULCAN.SharedKernel.i18n.Infrastructure\KUKULCAN.SharedKernel.i18n.Infrastructure.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="KUKULCAN.SharedKernel" Version="1.0.0" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.*" />
        <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.*" />
        <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.*" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.*" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.*" />
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.*" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="Serilog.Enrichers.Environment" Version="3.*" />
        <PackageReference Include="AspNetCore.HealthChecks.NpgSql" Version="9.*" />
        <PackageReference Include="AspNetCore.HealthChecks.Redis" Version="9.*" />
    </ItemGroup>

</Project>
