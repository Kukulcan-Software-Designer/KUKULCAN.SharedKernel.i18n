<Project>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <GeneratePackageOnBuild Condition="'$(Configuration)'=='Release'">true</GeneratePackageOnBuild>
        <SolutionDir>$(MSBuildThisFileDirectory)</SolutionDir>
        <PackageId>$(AssemblyName)</PackageId>
        <Version>$(VersionPrefix)</Version>
        <Authors>Kukulcakn Software Designer</Authors>
        <Company>Kukulcakn Software Designer</Company>
        <Copyright>GPL 2026 Kukulcakn Software Designer</Copyright>
        <PackageProjectUrl>https://www.kukulcan.org.mx/Software/KernelInternationalization</PackageProjectUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageOutputPath>$(SolutionDir)NuGet\</PackageOutputPath>
        <PackageTags>kukulcan;ddd;kernel;database;efcore;infrastructure</PackageTags>
        <PackageLicenseFile>LICENSE</PackageLicenseFile>
        <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
        <RepositoryUrl>https://github.com/Kukulcan-Software-Designer/KUKULCAN.SharedKernel.i18n</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <Description>
		KUKULCAN Software Designer's generic application internationalization microservice for the ATLAS platform.

		This version:
- Aligns service JWT configuration with ATLAS using ATLAS as the issuer and ATLAS.i18n as the audience.
- Standardizes the Docker image and container naming to kukulcan-i18n for local and CI execution.
- Provides HTTP-based internationalization capabilities for translations, locale configuration, and currency formatting.
- Preserves automatic English fallback for translation lookup.
</Description>
    </PropertyGroup>

	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<None Include="$(SolutionDir)LICENSE" Pack="true" PackagePath="\" />
		<None Include="$(SolutionDir)README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>
