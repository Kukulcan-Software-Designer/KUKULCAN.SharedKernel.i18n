{
  "Api": {
    "BaseUrl": "http://localhost:5000",
    "BearerToken": ""
  },

  "Atlas": {
    "Database": {
      "Provider": "PostgreSql",
      "ConnectionString": "Host=localhost;Port=5432;Database=kukulcan_i18n;Username=kukulcan;Password=kukulcan_pass;",
      "CommandTimeoutSeconds": 30,
      "EnableSensitiveDataLogging": false,
      "EnableDetailedErrors": false,
