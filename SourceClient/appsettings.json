        "Enabled": true,
        "MaxRetryCount": 3,
        "MaxRetryDelaySeconds": 30
      },
      "Pool": {
        "Enabled": true,
        "MinSize": 5,
        "MaxSize": 100
      },
      "Migration": {
        "AutoMigrateOnStartup": false,
        "SeedDataOnStartup": true
      }
    }
  }
}
